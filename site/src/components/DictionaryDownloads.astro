---
// "Download libraries" section: base frequency lists and thematic
// (professional) vocabularies, each linked to its GitHub Release asset so a
// visitor gets the file in one click. Reused on the landing page and on
// /dictionaries; both hosts (RU Layero / EN Vercel) render their own language.
import { pick } from "../lib/site";
import {
  baseLanguages,
  categoryCards,
  DICTIONARY_ASSET_BASE as RAW,
  humanSize,
} from "../lib/dictionaries";

const showAll = Astro.props.all !== false;
const shownCategories = showAll ? categoryCards : categoryCards.slice(0, 6);
---

<section id="dictionaries" class="border-t border-[#e5e5e5] py-16 sm:py-20 dark:border-[#3d3d3d]">
  <div class="container-page">
    <h2 class="text-center text-3xl font-bold tracking-tight sm:text-4xl">
      {pick("Скачать словари", "Download dictionaries")}
    </h2>
    <p class="mx-auto mt-4 max-w-2xl text-center text-[#0a0a0a]/70 dark:text-[#fafafa]/70">
      {
        pick(
          "Базовые частотные списки и профессиональные словари по разделам. Файлы берутся из последнего GitHub Release — один клик, без сборки.",
          "Base frequency lists and professional dictionaries by field. Files come straight from the latest GitHub Release — one click, no build.",
        )
      }
    </p>

    <h3 class="mt-12 text-xl font-semibold">{pick("Базовые частотные списки", "Base frequency lists")}</h3>
    <p class="mt-2 text-sm text-[#0a0a0a]/70 dark:text-[#fafafa]/70">
      {
        pick(
          "Топ-50k самых частых слов языка. Входят в .deb, но можно скачать отдельно.",
          "Top-50k most frequent words per language. Bundled in the .deb, but downloadable on their own.",
        )
      }
    </p>
    <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {
        baseLanguages.map((lang) => (
          <a
            href={`${RAW}/${lang.code}-50k.txt`}
            class="card flex items-center justify-between gap-3 transition-colors hover:border-[#1c71d8]/50 dark:hover:border-[#3584e4]/50"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="font-semibold">{lang.title}</span>
            <span class="font-mono text-xs text-[#1c71d8] dark:text-[#3584e4]">
              {lang.code}-50k.txt ↓
            </span>
          </a>
        ))
      }
    </div>

    <h3 class="mt-14 text-xl font-semibold">{pick("Профессиональные словари", "Professional dictionaries")}</h3>
    <p class="mt-2 text-sm text-[#0a0a0a]/70 dark:text-[#fafafa]/70">
      {
        pick(
          "Тематическая лексика для IT, медицины, юриспруденции, финансов, инженерии, науки, бизнеса, электроники, медиа, образования, игр и спорта. Ставится одной командой, не входит в .deb.",
          "Domain vocabulary for IT, medicine, law, finance, engineering, science, business, electronics, media, education, gaming and sport. Installed with one command, not bundled in the .deb.",
        )
      }
    </p>
    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        shownCategories.map((cat) => (
          <div class="card">
            <div class="flex items-start justify-between gap-2">
              <h4 class="font-semibold">{pick(cat.title.ru, cat.title.en)}</h4>
              <span class="shrink-0 rounded bg-[#fafafa] px-2 py-0.5 text-xs text-[#0a0a0a]/60 dark:bg-[#2d2d2d] dark:text-[#fafafa]/60">
                {cat.license}
              </span>
            </div>
            <p class="mt-2 text-sm text-[#0a0a0a]/70 dark:text-[#fafafa]/70">
              {pick(cat.blurb.ru, cat.blurb.en)}
            </p>
            <ul class="mt-3 space-y-1 text-xs">
              {cat.files.map((file) => (
                <li class="flex items-center justify-between gap-2">
                  <span>
                    {file.title} · {file.words} {pick("слов", "words")} · {humanSize(file.size)}
                  </span>
                  <a
                    class="shrink-0 text-[#1c71d8] underline dark:text-[#3584e4]"
                    href={`${RAW}/linguafix-dict-${cat.slug}.tar.gz`}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    .tar.gz
                  </a>
                </li>
              ))}
            </ul>
            <pre class="mt-3 overflow-x-auto rounded bg-[#1e1e1e] p-2 text-[11px] text-[#fafafa]"><code>{`linguafix dict install ${cat.slug} --lang ru`}</code></pre>
          </div>
        ))
      }
    </div>

    {
      showAll && (
        <p class="mt-6 text-sm text-[#0a0a0a]/70 dark:text-[#fafafa]/70">
          <a href="/dictionaries" class="text-[#1c71d8] underline dark:text-[#3584e4]">
            {pick("Каталог словарей →", "Full dictionary catalogue →")}
          </a>
        </p>
      )
    }
  </div>
</section>
