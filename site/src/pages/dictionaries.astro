---
import fs from "node:fs";
import path from "node:path";
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { REPO } from "../consts";
import { pick } from "../lib/site";

// One row per shipped language. The lists are attached to every GitHub Release
// (and bundled in the .deb), so the download links point at the stable
// ``/releases/latest/download`` assets rather than a branch path that only
// exists after a merge.
const RAW = `${REPO}/releases/latest/download`;
const languages = [
  { code: "ru", title: "Русский" },
  { code: "en", title: "English" },
  { code: "uk", title: "Українська" },
  { code: "de", title: "Deutsch" },
  { code: "fr", title: "Français" },
];

const title = pick("Расширенные словари — LinguaFix", "Extended dictionaries — LinguaFix");
const description = pick(
  "Базовые и тематические словари LinguaFix: IT, медицина, юриспруденция, финансы, инженерия. Подключение одной командой linguafix dict install.",
  "Base and thematic dictionaries for LinguaFix: IT, medicine, law, finance, engineering. Install with a single linguafix dict install command.",
);

const importCode = `linguafix dict download ru
linguafix dict install it --lang ru
# или вручную:
linguafix dict import-file ~/Downloads/ru-50k.txt`;

// Thematic categories. Sizes and word counts are read from the repository at
// build time so the cards never drift from what is actually shipped. Each
// category is published as one archive asset; the per-language files live
// inside it, and ``dict install`` extracts just the requested one.
type Category = {
  slug: string;
  title: string;
  blurb: string;
  license: string;
};

const categories: Category[] = [
  {
    slug: "it",
    title: pick("IT / программирование", "IT / programming"),
    blurb: pick(
      "Языки, фреймворки, git, БД, сети, DevOps.",
      "Languages, frameworks, git, databases, networks, DevOps.",
    ),
    license: "MIT",
  },
  {
    slug: "medicine",
    title: pick("Медицина и биология", "Medicine and biology"),
    blurb: pick(
      "Анатомия, болезни, препараты, диагностика.",
      "Anatomy, diseases, drugs, diagnostics.",
    ),
    license: "MIT",
  },
  {
    slug: "legal",
    title: pick("Юриспруденция", "Law"),
    blurb: pick("Кодексы, процессы, договоры, суд.", "Codes, proceedings, contracts, courts."),
    license: "MIT",
  },
  {
    slug: "finance",
    title: pick("Финансы и бухгалтерия", "Finance and accounting"),
    blurb: pick(
      "Банки, налоги, отчётность, инвестиции.",
      "Banking, taxes, reporting, investments.",
    ),
    license: "MIT",
  },
  {
    slug: "engineering",
    title: pick("Инженерия и строительство", "Engineering"),
    blurb: pick(
      "Сопромат, механизмы, материалы, ГОСТы.",
      "Mechanics, materials, drawings, standards.",
    ),
    license: "MIT",
  },
];

const dictRoot = path.resolve(process.cwd(), "..", "dictionaries");

function humanSize(bytes: number): string {
  if (bytes < 1024) return `${bytes} B`;
  if (bytes < 1024 * 1024) return `${Math.round(bytes / 1024)} KB`;
  return `${(bytes / 1024 / 1024).toFixed(1)} MB`;
}

function wordCount(file: string): number {
  try {
    return fs
      .readFileSync(file, "utf-8")
      .split("\n")
      .filter((line) => line.trim().length > 0).length;
  } catch {
    return 0;
  }
}

const categoryCards = categories.map((c) => {
  const files = [
    { lang: "ru", title: "Русский" },
    { lang: "en", title: "English" },
  ].map(({ lang, title }) => {
    const file = path.join(dictRoot, c.slug, `${lang}-${c.slug}-1k.txt`);
    let size = 0;
    try {
      size = fs.statSync(file).size;
    } catch {
      size = 0;
    }
    return { lang, title, size, words: wordCount(file) };
  });
  return { ...c, files };
});
---

<Base title={title} description={description}>
  <Header />
  <main>
    <section class="border-b border-[#e5e5e5] py-16 sm:py-20 dark:border-[#3d3d3d]">
      <div class="container-page mx-auto max-w-3xl">
        <h1 class="text-center text-3xl font-bold tracking-tight sm:text-4xl">
          {pick("Расширенные словари", "Extended dictionaries")}
        </h1>
        <p class="mx-auto mt-4 max-w-2xl text-center text-[#0a0a0a]/70 dark:text-[#fafafa]/70">
          {
            pick(
              "Дополнительные списки частотных слов расширяют словарь LinguaFix: больше настоящих слов распознаётся, меньше лишних исправлений. Это отдельно от пользовательского словаря — ничего общего с текстом, который вы набираете.",
              "Extra frequency word lists widen LinguaFix's vocabulary: more real words are recognised and fewer corrections are wrong. This is separate from the user dictionary and never touches the text you type.",
            )
          }
        </p>
      </div>
    </section>

    <section class="py-16 sm:py-20">
      <div class="container-page mx-auto max-w-3xl">
        <div class="overflow-hidden rounded-lg border border-[#e5e5e5] dark:border-[#3d3d3d]">
          <table class="w-full text-left text-sm">
            <thead class="bg-[#fafafa] dark:bg-[#2d2d2d]">
              <tr>
                <th class="px-4 py-3 font-semibold">{pick("Язык", "Language")}</th>
                <th class="px-4 py-3 font-semibold">{pick("Файл", "File")}</th>
                <th class="px-4 py-3 font-semibold">{pick("Скачать", "Download")}</th>
              </tr>
            </thead>
            <tbody>
              {
                languages.map((entry) => (
                  <tr class="border-t border-[#e5e5e5] dark:border-[#3d3d3d]">
                    <td class="px-4 py-3">{entry.title}</td>
                    <td class="px-4 py-3 font-mono text-xs">{entry.code}-50k.txt</td>
                    <td class="px-4 py-3">
                      <a
                        class="text-[#1c71d8] underline dark:text-[#3584e4]"
                        href={`${RAW}/${entry.code}-50k.txt`}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {entry.code}-50k.txt
                      </a>
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>

        <h2 class="mt-16 text-2xl font-bold">
          {pick("Тематические словари", "Thematic dictionaries")}
        </h2>
        <p class="mt-3 text-[#0a0a0a]/70 dark:text-[#fafafa]/70">
          {
            pick(
              "Профессиональная лексика по разделам. Подключаются поверх базового словаря и не входят в .deb — ставятся одной командой.",
              "Professional vocabulary by field. Loaded on top of the base list and not bundled in the .deb — install with one command.",
            )
          }
        </p>

        <div class="mt-6 grid gap-4 sm:grid-cols-2">
          {
            categoryCards.map((cat) => (
              <div class="rounded-lg border border-[#e5e5e5] p-4 dark:border-[#3d3d3d]">
                <div class="flex items-start justify-between gap-2">
                  <h3 class="font-semibold">{cat.title}</h3>
                  <span class="shrink-0 rounded bg-[#fafafa] px-2 py-0.5 text-xs text-[#0a0a0a]/60 dark:bg-[#2d2d2d] dark:text-[#fafafa]/60">
                    {cat.license}
                  </span>
                </div>
                <p class="mt-2 text-sm text-[#0a0a0a]/70 dark:text-[#fafafa]/70">{cat.blurb}</p>
                <ul class="mt-3 space-y-1 text-xs">
                  {cat.files.map((file) => (
                    <li class="flex items-center justify-between gap-2">
                      <span>
                        {file.title} · <span class="font-mono">{file.lang}-{cat.slug}-1k.txt</span> · {file.words}{" "}
                        {pick("слов", "words")} · {humanSize(file.size)}
                      </span>
                      <a
                        class="shrink-0 text-[#1c71d8] underline dark:text-[#3584e4]"
                        href={`${RAW}/linguafix-dict-${cat.slug}.tar.gz`}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        .tar.gz
                      </a>
                    </li>
                  ))}
                </ul>
                <pre class="mt-3 overflow-x-auto rounded bg-[#1e1e1e] p-2 text-[11px] text-[#fafafa]"><code>{`linguafix dict install ${cat.slug} --lang ru`}</code></pre>
              </div>
            ))
          }
        </div>

        <h2 class="mt-16 text-2xl font-bold">{pick("Как подключить", "How to load")}</h2>
        <p class="mt-3 text-[#0a0a0a]/70 dark:text-[#fafafa]/70">
          {
            pick(
              "Скачайте файл и импортируйте его — или просто попросите LinguaFix скачать словарь самостоятельно.",
              "Download a file and import it — or let LinguaFix download the dictionary for you.",
            )
          }
        </p>
        <pre class="mt-4 overflow-x-auto rounded-lg bg-[#1e1e1e] p-4 text-xs text-[#fafafa]"><code>{importCode}</code></pre>

        <p class="mt-8 text-xs text-[#0a0a0a]/60 dark:text-[#fafafa]/60">
          {
            pick(
              "Источник словарей: FrequencyWords (hermitdave/FrequencyWords), лицензия MIT. Файлы в репозитории содержат только столбец слов.",
              "Dictionary source: FrequencyWords (hermitdave/FrequencyWords), MIT licence. The repository files keep only the word column.",
            )
          }
        </p>
      </div>
    </section>
  </main>
  <Footer />
</Base>
