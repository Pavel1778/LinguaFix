[Desktop Entry]
Type=Application
Name=LinguaFix
GenericName=Auto Layout Switcher
Comment=Автоматическое переключение раскладки клавиатуры
# @BIN@ is substituted at install time: install.sh uses the venv launcher,
# the .deb uses /usr/bin/linguafix.
Exec=@BIN@ gui
Icon=linguafix
StartupWMClass=io.github.pavel1778.LinguaFix
Terminal=false
Categories=Utility;Accessibility;
Keywords=keyboard;layout;switcher;
StartupNotify=true
