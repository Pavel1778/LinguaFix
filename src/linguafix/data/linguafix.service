[Unit]
Description=LinguaFix — автоматический переключатель раскладки
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
# @BIN@ is substituted at install time: install.sh uses the venv launcher,
# the .deb uses /usr/bin/linguafix.
ExecStart=@BIN@ start --foreground
Restart=always
RestartSec=5
# Keep the daemon responsive: a layout fix must beat the compositor's own
# handling of the boundary key that triggered it.
Nice=-10
CPUSchedulingPolicy=rr
CPUSchedulingPriority=20
Environment=PYTHONUNBUFFERED=1
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
