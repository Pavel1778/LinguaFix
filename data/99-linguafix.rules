# LinguaFix udev rules.
#
# Access is granted with TAG+="uaccess" rather than by adding the user to the
# "input" group. uaccess gives a POSIX ACL to the user who is physically logged
# in at the seat (the active session), dynamically and only for that user. It
# needs no usermod and no relogin, and it is revoked when the session ends.
#
# Installed to /usr/lib/udev/rules.d/ by the package; run
#   sudo udevadm control --reload-rules && sudo udevadm trigger
# after editing.

# Read access to keyboard event devices for the active session user.
KERNEL=="event*", TAG+="uaccess"

# Write access to the virtual keyboard used to rewrite text. static_node creates
# /dev/uinput on boot when the uinput module is already loaded.
KERNEL=="uinput", TAG+="uaccess", OPTIONS+="static_node=uinput"
